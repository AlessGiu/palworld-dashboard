# Full path to ooz/libooz.dll — required by the patched palsav.py to decompress Oodle (.sav) saves.
PALWORLD_OOZ_DLL_PATH=C:\path\to\palworld-hostfix-toolkit\ooz\libooz.dll

# Optional: in-game player name used as a ground-truth anchor by scripts/anchor_search.py
# and scripts/brute_group.py when debugging guild/group struct layouts. Only needed if you
# run those two diagnostic scripts; leave unset otherwise.
ANCHOR_PLAYER_NAME=PLAYER_NAME
